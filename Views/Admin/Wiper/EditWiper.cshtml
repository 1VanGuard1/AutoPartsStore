@model Product

@{
    ViewData["Title"] = "Редактирование стеклоочистителя";
    Layout = "_LayoutAdmin";
}
<h2>Редактирование стеклоочистителя</h2>

<form asp-action="Edit" asp-controller="Wiper" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="ProductID" />

    <div class="mb-2">
        <label>Название</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Цена</label>
        <input asp-for="Price" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Производитель</label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <hr />

    <h4>Характеристики стеклоочистителя</h4>

    <div class="mb-2">
        <label>Сезон</label>
        <input asp-for="Wiper.Season" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Длина</label>
        <input asp-for="Wiper.Length" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Тип монтирования</label>
        <input asp-for="Wiper.MountType" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Материал</label>
        <input asp-for="Wiper.Material" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Новое изображение</label>
        <input type="file" name="image" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">💾 Сохранить</button>
    <a asp-action="Index" asp-controller="Admin" class="btn btn-secondary">↩ Назад</a>

</form>
