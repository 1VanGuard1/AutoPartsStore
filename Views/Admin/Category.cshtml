@model IEnumerable<Product>

@{
    ViewData["Title"] = "Админка — Категории";
    Layout = "_LayoutAdmin";
}

<h2>@ViewBag.Category.CategoryName</h2>

<div class="mb-3">
    <a asp-controller="@ViewBag.ControllerName"
       asp-action="Add"
       class="btn btn-success">
        Добавить товар
    </a>
</div>

<div class="row">
    @foreach (var p in Model)
    {
        <div class="col-md-3 mb-4">
            <article class="product-card">
                <div class="thumb">
                    <a asp-controller="@ViewBag.ControllerName"
                       asp-action="Edit"
                       asp-route-id="@p.ProductID">

                        <img src="@(p.ImageData == null 
                                  ? "/images/placeholder.png" 
                                  : $"data:image/jpeg;base64,{Convert.ToBase64String(p.ImageData)}")" 
                             alt="@p.ProductName" />
                    </a>
                </div>

                <div class="card-body">
                    <div class="product-title">@p.ProductName</div>
                    <div class="meta">Цена: @p.Price руб.</div>

                    <div class="card-actions mt-3">

                        <a asp-controller="@ViewBag.ControllerName"
                           asp-action="Edit"
                           asp-route-id="@p.ProductID"
                           class="btn btn-warning btn-block">
                            Редактировать
                        </a>

                        <a asp-controller="@ViewBag.ControllerName"
                           asp-action="Delete"
                           asp-route-id="@p.ProductID"
                           class="btn btn-danger btn-block"
                           onclick="return confirm('Удалить товар?');">
                            Удалить
                        </a>
                    </div>
                </div>
            </article>
        </div>
    }
</div>
