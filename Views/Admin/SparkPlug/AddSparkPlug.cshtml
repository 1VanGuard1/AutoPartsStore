@model AutoPartsStore.Models.ViewModels.Admin.BatteryViewModel

@{
    ViewData["Title"] = "Добавить аккумулятор";
    Layout = "_Layout";
}
<h2>Добавить аккумулятор</h2>

<form asp-action="AddBattery" method="post" enctype="multipart/form-data" class="mt-4">

    <h4>Общие данные</h4>

    <div class="form-group mb-2">
        <label>Категория</label>
        <select asp-for="CategoryID" class="form-control" asp-items="ViewBag.Categories"></select>
    </div>

    <div class="form-group mb-2">
        <label>Название</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Цена</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Производитель</label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group mb-4">
        <label>Изображение</label>
        <input type="file" name="image" class="form-control" />
    </div>

    <hr />

    <h4>Характеристики аккумулятора</h4>

    <div class="form-group mb-2">
        <label>Ёмкость (Ah)</label>
        <input asp-for="Capacity" type="number" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Полярность</label>
        <input asp-for="Polarity" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Гарантия (мес)</label>
        <input asp-for="WarrantyPeriod" type="number" class="form-control" />
    </div>

    <div class="form-group mb-4">
        <label>Напряжение (V)</label>
        <input asp-for="Voltage" type="number" step="0.1" class="form-control" />
    </div>

    <button class="btn btn-success w-100">
        ✅ Добавить аккумулятор
    </button>

</form>
