@model Product

@{
    ViewData["Title"] = "Редактирование шин";
    Layout = "_Layout";
}
<h2>Редактирование шин</h2>

<form asp-action="Edit" asp-controller="Tire" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="ProductID" />

    <div class="mb-2">
        <label>Название</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Цена</label>
        <input asp-for="Price" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Производитель</label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <hr />

    <h4>Характеристики шин</h4>

    <div class="mb-2">
        <label>Диаметр</label>
        <input asp-for="Tire.Diameter" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Высота</label>
        <input asp-for="Tire.Height" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Ширина</label>
        <input asp-for="Tire.Width" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Сезон</label>
        <input asp-for="Tire.Season" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Тип</label>
        <input asp-for="Tire.Type" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Новое изображение</label>
        <input type="file" name="image" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">💾 Сохранить</button>
    <a asp-action="Index" class="btn btn-secondary">↩ Назад</a>

</form>
