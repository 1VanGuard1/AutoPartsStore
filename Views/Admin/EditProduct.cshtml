@model AutoPartsStore.Models.Product

@{
    ViewData["Title"] = "Редактировать товар";
}

<h2 class="mb-4">Редактировать товар</h2>

<form asp-action="EditProduct" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="ProductID" />
    <input type="hidden" asp-for="CategoryID" />

    <div class="mb-3">
        <label asp-for="ProductName" class="form-label">Название</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label">Цена</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Manufacturer" class="form-label">Производитель</label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Текущее изображение</label><br />
        <img src="@(Model.ImageUrl ?? "/images/placeholder.png")"
             style="width:120px; height:120px; object-fit:cover; border-radius:6px;" />
    </div>

    <div class="mb-3">
        <label class="form-label">Загрузить новое</label>
        <input type="file" name="imageFile" class="form-control" />
    </div>

    <button class="btn btn-primary">Сохранить</button>

    <a asp-action="Products"
       asp-route-categoryId="@Model.CategoryID"
       class="btn btn-secondary ms-2">
        Назад
    </a>

</form>
