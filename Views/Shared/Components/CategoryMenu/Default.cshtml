@model IEnumerable<AutoPartsStore.Models.Category>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">

        <a class="navbar-brand fw-semibold"
           asp-controller="Home"
           asp-action="Index">
            В начало
        </a>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#categoryMenu"
                aria-controls="categoryMenu"
                aria-expanded="false"
                aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="categoryMenu">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                @foreach (var c in Model)
                {
                    string russianName = c.CategoryName switch
                    {
                        "Batteries" => "Аккумуляторы",
                        "Tires" => "Шины",
                        "Motor Oils" => "Моторные масла",
                        "Brake Pads" => "Тормозные колодки",
                        "Wipers" => "Дворники",
                        "Spark Plugs" => "Свечи зажигания",
                        _ => c.CategoryName
                    };

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Products"
                           asp-action="Category"
                           asp-route-categoryId="@c.CategoryID">
                            @russianName
                        </a>
                    </li>
                }
            </ul>

            <div class="d-flex">
                <a asp-controller="Cart"
                   asp-action="Index"
                   class="btn btn-outline-success btn-sm">
                    Корзина
                </a>
            </div>
        </div>
    </div>
</nav>
