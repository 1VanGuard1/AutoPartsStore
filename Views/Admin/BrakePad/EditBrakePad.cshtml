@model Product

@{
    ViewData["Title"] = "Редактирование тормозных колодок";
    Layout = "_Layout";
}
<h2>Редактирование тормозных колодок</h2>

<form asp-action="Edit" asp-controller="BrakePad" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="ProductID" />

    <div class="mb-2">
        <label>Название</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Цена</label>
        <input asp-for="Price" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Производитель</label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <hr />

    <h4>Характеристики тормозных колодок</h4>

    <div class="mb-2">
        <label>Материал</label>
        <input asp-for="BrakePad.Material" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Толщина</label>
        <input asp-for="BrakePad.Thickness" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Совместимость</label>
        <input asp-for="BrakePad.Compatibility" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Тип</label>
        <input asp-for="BrakePad.PadType" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Новое изображение</label>
        <input type="file" name="image" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">💾 Сохранить</button>
    <a asp-action="Index" class="btn btn-secondary">↩ Назад</a>

</form>
