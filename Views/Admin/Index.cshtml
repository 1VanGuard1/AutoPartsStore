@model List<Product>

@{
    ViewData["Title"] = "Админ-панель";
    Layout = "_Layout";
}

<h2 class="mb-4">Админ-панель — Список товаров</h2>

<div class="mb-3 d-flex gap-2">
    <a asp-action="AddBattery" class="btn btn-success">
        ➕ Добавить аккумулятор
    </a>

    <a asp-action="Categories" class="btn btn-primary">
        📂 Категории
    </a>
</div>

<table class="table table-bordered table-striped align-middle shadow-sm">
    <thead class="table-dark text-center">
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Категория</th>
            <th>Цена</th>
            <th>Производитель</th>
            <th>Изображение</th>
            <th width="220">Действия</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td class="text-center">@p.ProductID</td>

                <td>@p.ProductName</td>

                <td>@p.Category?.CategoryName</td>

                <td>@p.Price руб.</td>

                <td>@p.Manufacturer</td>

                <td class="text-center">
                    @if (p.ImageData != null)
                    {
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(p.ImageData)"
                             width="60"
                             style="border-radius:6px;" />
                    }
                    else
                    {
                        <span class="text-muted">Нет</span>
                    }
                </td>

                <td class="text-center">

                    <!-- ✅ РЕДАКТИРОВАТЬ -->
                    <a asp-action="EditProduct"
                       asp-route-id="@p.ProductID"
                       class="btn btn-sm btn-warning me-1">
                        ✏
                    </a>

                    <!-- ✅ УДАЛИТЬ -->
                    <a asp-action="DeleteProduct"
                       asp-route-id="@p.ProductID"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Удалить товар?')">
                        ❌
                    </a>

                </td>
            </tr>
        }
    </tbody>
</table>
