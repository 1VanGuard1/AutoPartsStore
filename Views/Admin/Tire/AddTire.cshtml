@model AutoPartsStore.Models.ViewModels.Admin.TireViewModel

@{
    ViewData["Title"] = "Добавить шину";
    Layout = "_Layout";
}
<h2>Добавить шину</h2>

<form asp-action="AddBattery" method="post" enctype="multipart/form-data" class="mt-4">

    <h4>Общие данные</h4>

    <div class="form-group mb-2">
        <label>Категория</label>
        <select asp-for="CategoryID" class="form-control" asp-items="ViewBag.Categories"></select>
    </div>

    <div class="form-group mb-2">
        <label>Название</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Цена</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Производитель</label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group mb-4">
        <label>Изображение</label>
        <input type="file" name="image" class="form-control" />
    </div>

    <hr />

    <h4>Характеристики шины</h4>


    <div class="form-group mb-4">
        <label>Шмрина</label>
        <input asp-for="Width" type="number" step="0.1" class="form-control" />
    </div>

    <div class="form-group mb-4">
        <label>Высота</label>
        <input asp-for="Height" type="number" step="0.1" class="form-control" />
    </div>

    <div class="form-group mb-4">
        <label>Диаметр</label>
        <input asp-for="Diameter" type="number" step="0.1" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Сезон</label>
        <input asp-for="Season" type="number" class="form-control" />
    </div>

    <div class="form-group mb-4">
        <label>Тип</label>
        <input asp-for="Type" class="form-control" />
    </div>

    <button class="btn btn-success w-100">
        ✅ Добавить шину
    </button>

</form>
