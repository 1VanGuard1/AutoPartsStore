@model AutoPartsStore.Models.Product

<div class="product-card">
    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.ImageData)" alt="@Model.ProductName" />

    @* <img src="C:\\Users\\vangu\\Downloads\\vecteezy_black-rubber-car-tires-transparent_13362876.png" alt="image" />  *@

    <div class="product-card-body">
        <div class="product-title">@Model.ProductName</div>

        <div class="text-muted small">
            @Model.Manufacturer
        </div>

        <div class="product-price">
            @Model.Price руб.
        </div>


        <a class="btn btn-primary w-100 mt-3" 
        asp-controller="Products" asp-action="Details" asp-route-productId="@Model.ProductID" asp-route-id="@Model.ProductID">           
            Подробнее
        </a>
    </div>
</div>
