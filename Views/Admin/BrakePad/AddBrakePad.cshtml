@model AutoPartsStore.Models.ViewModels.Admin.BrakePadViewModel

@{
    ViewData["Title"] = "Добавить тормозные колодки";
    Layout = "_LayoutAdmin";
}

<h2>Добавить тормозные колодки</h2>

<form asp-action="Add" asp-controller="BrakePad" method="post" enctype="multipart/form-data" class="mt-4">

    <h4>Общие данные</h4>

    <div class="form-group mb-2">
        <label>Категория</label>
        <select asp-for="CategoryID" class="form-control" asp-items="ViewBag.Categories"></select>
    </div>

    <div class="form-group mb-2">
        <label>Название</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Цена</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Производитель</label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group mb-4">
        <label>Изображение</label>
        <input type="file" name="image" class="form-control" />
    </div>

    <hr />

    <h4>Характеристики тормозных колодок</h4>

    <div class="form-group mb-2">
        <label>Материал</label>
        <input asp-for="Material" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Толщина (мм)</label>
        <input asp-for="Thickness" type="number" step="0.1" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Совместимость</label>
        <input asp-for="Compatibility" class="form-control" />
    </div>

    <div class="form-group mb-4">
        <label>Тип колодок</label>
        <input asp-for="PadType" class="form-control" />
    </div>

    <button class="btn btn-success w-100">
        ✅ Добавить тормозные колодки
    </button>

</form>
