@model IEnumerable<Category>

@{
    ViewData["Title"] = "Панель администратора";
    Layout = "_LayoutAdmin";
}

<h2 class="mb-4">Панель администратора</h2>

<div class="row">
    <div class="row mb-3">
        <div class="col-md-12">
            <a href="@Url.Action("SalesReport", "Admin")" class="btn btn-success btn-lg">
                <i class="bi bi-file-earmark-excel"></i> Отчёт о продажах
            </a>
        </div>
    </div>

    @foreach (var c in Model)
    {
        var firstProduct = c.Products?.FirstOrDefault();

        <div class="col-md-3 mb-4">
            <article class="product-card">

                <div class="thumb">
                    <a asp-controller="Admin"
                       asp-action="Category"
                       asp-route-id="@c.CategoryID">

                        @if (firstProduct?.ImageData != null)
                        {
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(firstProduct.ImageData)"
                                 alt="@c.CategoryName" />
                        }
                        else
                        {
                            <img src="/images/placeholder.png"
                                 alt="Нет изображения" />
                        }

                    </a>
                </div>

                <div class="card-body">
                    <div class="product-title">@CategoryControllerMapper.GetRussianName(c.CategoryName)</div>

                    <div class="card-actions mt-3">
                        <a asp-controller="Admin"
                           asp-action="Category"
                           asp-route-id="@c.CategoryID"
                           class="btn btn-primary btn-block">
                            Открыть
                        </a>
                    </div>
                </div>

            </article>
        </div>
    }
</div>
