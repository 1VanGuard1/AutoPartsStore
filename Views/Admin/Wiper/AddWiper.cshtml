@model AutoPartsStore.Models.ViewModels.Admin.WiperViewModel

@{
    ViewData["Title"] = "Добавить стеклоочиститель";
    Layout = "_LayoutAdmin";
}
<h2>Добавить стеклоочиститель</h2>

<form asp-action="Add" method="post" enctype="multipart/form-data" class="mt-4">

    <h4>Общие данные</h4>

    <div class="form-group mb-2">
        <label>Категория</label>
        <select asp-for="CategoryID" class="form-control" asp-items="ViewBag.Categories"></select>
    </div>

    <div class="form-group mb-2">
        <label>Название</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Цена</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Производитель</label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group mb-4">
        <label>Изображение</label>
        <input type="file" name="image" class="form-control" />
    </div>

    <hr />

    <h4>Характеристики стеклоочистителя</h4>

    <div class="form-group mb-2">
        <label>Длина</label>
        <input asp-for="Length" type="number" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Тип крепления</label>
        <input asp-for="MountType" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Сезон</label>
        <input asp-for="Season"class="form-control" />
    </div>

    <div class="form-group mb-4">
        <label>Материал</label>
        <input asp-for="Material" class="form-control" />
    </div>

    <button class="btn btn-success w-100">
        ✅ Добавить стеклоочиститель
    </button>

</form>
