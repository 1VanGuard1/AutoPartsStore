@model AutoPartsStore.Models.ViewModels.Admin.SparkPlugViewModel

@{
    ViewData["Title"] = "Добавить свечу зажигания";
    Layout = "_LayoutAdmin";
}
<h2>Добавить свечу зажигания</h2>

<form asp-action="Add" method="post" enctype="multipart/form-data" class="mt-4">

    <h4>Общие данные</h4>

    <div class="form-group mb-2">
        <label>Категория</label>
        <select asp-for="CategoryID" class="form-control" asp-items="ViewBag.Categories"></select>
    </div>

    <div class="form-group mb-2">
        <label>Название</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Цена</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Производитель</label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="form-group mb-4">
        <label>Изображение</label>
        <input type="file" name="image" class="form-control" />
    </div>

    <hr />


    <h4>Характеристики свечи зажигания</h4>

    <div class="form-group mb-2">
        <label>Тепловой диапазон</label>
        <input asp-for="HeatRange" type="number" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Материал электрода</label>
        <input asp-for="ElectrodeMaterial" class="form-control" />
    </div>

    <div class="form-group mb-2">
        <label>Размер резьбы</label>
        <input asp-for="ThreadSize" class="form-control" />
    </div>

    <div class="form-group mb-4">
        <label>Зазор</label>
        <input asp-for="Gap" type="number" step="0.1" class="form-control" />
    </div>

    <button class="btn btn-success w-100">
        ✅ Добавить свечу зажигания
    </button>

</form>
