<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AutoPartsStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AutoPartsStore.styles.css" asp-append-version="true" />
    <script src="~/js/cart.js"></script>

</head>
<body>
    <header>
        @await Component.InvokeAsync("CategoryMenu")
    </header>
    <form method="get" asp-action="Search" asp-controller="Products" class="d-flex">
        <input type="text" name="query" class="form-control me-2" placeholder="Поиск по всем товарам..." />
        <button class="btn btn-outline-primary" type="submit">Поиск</button>
    </form>

    <div class="container">
        @RenderBody()
    </div>
</body>

</html>
