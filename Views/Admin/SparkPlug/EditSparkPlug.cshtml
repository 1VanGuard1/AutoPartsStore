@model Product

@{
    ViewData["Title"] = "Редактирование свечей зажигания";
    Layout = "_LayoutAdmin";
}
<h2>Редактирование свечей зажигания</h2>

<form asp-action="Edit" asp-controller="SparkPlug" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="ProductID" />

    <div class="mb-2">
        <label>Название</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Цена</label>
        <input asp-for="Price" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Производитель</label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <hr />

    <h4>Характеристики свечей зажигания</h4>

    <div class="mb-2">
        <label>Размер резьбы</label>
        <input asp-for="SparkPlug.ThreadSize" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Тепловой диапазон</label>
        <input asp-for="SparkPlug.HeatRange" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Материал электрода</label>
        <input asp-for="SparkPlug.ElectrodeMaterial" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Зазор</label>
        <input asp-for="SparkPlug.Gap" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Новое изображение</label>
        <input type="file" name="image" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">💾 Сохранить</button>
    <a asp-action="Index" asp-controller="Admin" class="btn btn-secondary">↩ Назад</a>

</form>
