@model Product

@{
    ViewData["Title"] = "Редактирование моторного масла";
    Layout = "_LayoutAdmin";
}
<h2>Редактирование моторного масла</h2>

<form asp-action="Edit" asp-controller="MotorOil" method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="ProductID" />

    <div class="mb-2">
        <label>Название</label>
        <input asp-for="ProductName" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Цена</label>
        <input asp-for="Price" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Производитель</label>
        <input asp-for="Manufacturer" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Описание</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <hr />

    <h4>Характеристики моторного масла</h4>

    <div class="mb-2">
        <label>Вязкость</label>
        <input asp-for="MotorOil.Viscosity" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Тип масла</label>
        <input asp-for="MotorOil.OilType" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Страна производитель</label>
        <input asp-for="MotorOil.ManufacturerCountry" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Объем</label>
        <input asp-for="MotorOil.Volume" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Новое изображение</label>
        <input type="file" name="image" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">💾 Сохранить</button>
    <a asp-action="Index" asp-controller="Admin" class="btn btn-secondary">↩ Назад</a>

</form>
