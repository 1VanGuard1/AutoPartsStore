@model List<CartViewModelItem>

@{
    ViewData["Title"] = "Корзина";
    Layout = "_Layout";

    decimal total = Model.Sum(x => x.Product.Price * x.Quantity);
}

<section class="container mt-4">
    <h2 class="mb-3">Корзина</h2>

    @if (TempData["OrderSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["OrderSuccess"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Ваша корзина пуста.
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Перейти к покупкам</a>
    }
    else
    {
        <!-- список товаров -->
        <div id="cart-body" class="mb-3">
            @foreach (var item in Model)
            {
                var lineTotal = item.Product.Price * item.Quantity;

                <div class="border rounded p-2 p-md-3 mb-2 cart-item"
                     data-product-id="@item.Product.ProductID">

                    <div class="d-flex">
                        <div style="width:70px;height:70px;overflow:hidden;border-radius:4px;margin-right:10px;background:#f8f9fa;">
                            @if (item.Product.ImageData != null && item.Product.ImageData.Length > 0)
                            {
                                var base64 = Convert.ToBase64String(item.Product.ImageData);
                                <img src="data:image/jpeg;base64,@base64"
                                     style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                <img src="/images/placeholder.png"
                                     style="width:100%;height:100%;object-fit:cover;" />
                            }
                        </div>

                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong>@item.Product.ProductName</strong><br />
                                    <span class="text-muted small">@item.Product.Manufacturer</span>
                                </div>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger btn-remove ms-2">
                                    ×
                                </button>
                            </div>

                            <div class="d-flex flex-wrap align-items-center mt-2">
                                <div class="input-group input-group-sm" style="max-width: 140px;">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-qty-minus">
                                        -
                                    </button>
                                    <input type="text"
                                           class="form-control text-center qty-input"
                                           value="@item.Quantity"
                                           readonly />
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-qty-plus">
                                        +
                                    </button>
                                </div>

                                <div class="ms-3 text-muted small">
                                    Цена: @item.Product.Price.ToString("N2") руб.
                                </div>

                                <div class="ms-auto fw-semibold">
                                    <span class="text-muted small">Сумма:</span>
                                    <span class="line-total">@lineTotal.ToString("N2") руб.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- итог -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="text-muted" id="cart-total-qty">Всего товаров: @Model.Sum(x => x.Quantity)</div>
            <div>
                <span class="me-2 fw-semibold">Итого:</span>
                <span id="cart-total" class="fw-bold">@total.ToString("N2") руб.</span>
            </div>
        </div>

        <hr />

        <!-- оформление заказа -->
        <h4>Оформление заказа</h4>

        <form method="post" asp-action="Checkout" class="row g-3 mt-2">
            <div class="col-md-4">
                <label class="form-label">ФИО</label>
                <input type="text" name="fullName" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Телефон</label>
                <input type="tel" name="phone" class="form-control" required />
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-success">
                    Оформить заказ
                </button>
            </div>
        </form>
    }
</section>

@section Scripts {
    <script>
        function postCartAction(url, productId, onSuccess) {
            fetch(url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                },
                body: "productId=" + encodeURIComponent(productId)
            })
                .then(r => r.json())
                .then(data => {
                    if (data.ok && onSuccess) onSuccess();
                })
                .catch(err => console.error(err));
        }
function recalcTotals() {
    let total = 0;
    let totalQty = 0;

    document.querySelectorAll("#cart-body .cart-item").forEach(item => {
        const qty = parseInt(item.querySelector(".qty-input").value || "0");
        totalQty += qty;

        const priceText = item.querySelector(".text-muted.small:nth-of-type(2)")?.innerText
            .replace("Цена:", "")
            .replace("руб.", "")
            .replace(/\s/g, "")
            .replace(",", ".") || "0";

        const price = parseFloat(priceText) || 0;
        const line = qty * price;
        item.querySelector(".line-total").innerText = line.toFixed(2) + " руб.";
        total += line;
    });

    document.getElementById("cart-total").innerText = total.toFixed(2) + " руб.";
    const totalQtyElem = document.getElementById("cart-total-qty");
    if (totalQtyElem) {
        totalQtyElem.textContent = "Всего товаров: " + totalQty;
    }
}



        document.addEventListener("click", function (e) {
            const item = e.target.closest(".cart-item[data-product-id]");
            if (!item) return;
            const productId = item.getAttribute("data-product-id");

            if (e.target.classList.contains("btn-qty-plus")) {
                postCartAction("@Url.Action("Increment", "Cart")", productId, function () {
                    const input = item.querySelector(".qty-input");
                    input.value = parseInt(input.value || "0") + 1;
                    recalcTotals();
                });
            }

            if (e.target.classList.contains("btn-qty-minus")) {
                postCartAction("@Url.Action("Decrement", "Cart")", productId, function () {
                    const input = item.querySelector(".qty-input");
                    const newVal = parseInt(input.value || "0") - 1;
                    if (newVal <= 0) {
                        item.remove();
                    } else {
                        input.value = newVal;
                    }
                    recalcTotals();
                });
            }

            if (e.target.classList.contains("btn-remove")) {
                postCartAction("@Url.Action("Remove", "Cart")", productId, function () {
                    item.remove();
                    recalcTotals();
                });
            }
        });
    </script>
}
